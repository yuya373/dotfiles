{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "SHELL": "/usr/sbin/bash",
    "DISABLE_MICROCOMPACT": 1,
    "DISABLE_INTERLEAVED_THINKING": 1
  },
  "permissions": {
    "allow": [
      "Bash",
      "mcp__emacs",
      "WebFetch",
      "WebSearch",
      "Fetch"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git reset:*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude_notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/claude/statusline.sh",
    "padding": 0
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754131771113
  },
  "model": "opus"
}
